// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER        // مالك المنصة — فوق الكل، لا يخضع لأي قيود
  ADMIN
  SUPPLIER
  CUSTOMER
  MODERATOR
  SUPPORT
  EDITOR
  DEVELOPER
  LOGISTICS
  PAIR         // شريك — له profile عام + followers
  SUBLAYER     // طبقة فرعية — يظهر في قسم Sublayer + User Management
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  BLOCKED
  DELETED
}

enum KYCStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT          // saved by the supplier, incomplete or not yet submitted — never public
  PENDING        // submitted, awaiting admin review
  APPROVED       // admin approved, live on the catalog
  REJECTED       // admin rejected — supplier blocked from re-submitting
  NEEDS_CHANGES  // admin sent a comment; supplier must fix and resend
}

enum PlacementType {
  HERO
  FEATURED
  LISTING
  BANNER
}

enum PlacementStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  password             String
  name                 String
  role                 Role       @default(CUSTOMER)
  status               UserStatus @default(PENDING_APPROVAL)
  phone                String?
  avatar               String?
  companyName          String?
  website              String?
  socialLinks          String?
  verificationToken    String?
  emailVerified        Boolean    @default(false)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  stripeCustomerId     String?    // Stripe customer ID for saved cards (buyers)
  stripeAccountId      String?    // Stripe Connect account ID (suppliers)
  permissions          Json? // Array of permission strings
  // Per-user notification preferences. Operator-requested.
  // Shape: { orderUpdates: boolean, productComments: boolean,
  //          lowStockAlerts: boolean, inboundOffers: boolean,
  //          marketingEmails: boolean, muteToasts: boolean }
  // When `muteToasts` is true the bell icon still updates but no
  // pop-over toast appears — quiet mode for users who don't want
  // visual interrupts. Missing keys default to true (subscribed)
  // so legacy rows behave exactly as before.
  notificationPrefs    Json?
  // First-login dashboard tours (UI onboarding only — unrelated to
  // `onboardingCompleted`, which means "business profile completed").
  // Shape: { "<tourId>": { "status": "started" | "completed" | "skipped",
  //          "step": number, "at": ISO string } }. Null = no tour seen yet.
  // Read/written only via GET/PATCH /users/me/tours (src/users/product-tours.ts).
  productTours         Json?
  // Supplier's chosen currency for entering prices (ISO code). Null = suggest from country.
  defaultCurrency      String?
  targetPriceRequests  TargetPriceRequest[] @relation("TargetPriceBuyer")
  productReviewEvents  ProductReviewEvent[] @relation("ProductReviewActor")

  // Two-Factor Authentication
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?   // Encrypted TOTP secret
  emailOtpCode         String?   // Temporary email OTP
  emailOtpExpiry       DateTime? // OTP expiration
  /// Set for accounts created by the verified sign-up flow; sign-in is blocked until emailVerified.
  emailVerificationRequired Boolean  @default(false)
  emailVerifyCodeHash       String?  // SHA-256 of the 6-digit sign-up code (never the code itself)
  emailVerifyExpiry         DateTime?
  emailVerifyAttempts       Int      @default(0)
  emailVerifySentAt         DateTime?
  /// Change-email: the new address is applied only after its code is confirmed.
  pendingEmail              String?
  pendingEmailCodeHash      String?
  pendingEmailExpiry        DateTime?
  pendingEmailAttempts      Int      @default(0)
  pendingEmailSentAt        DateTime?
  /// Wholesale profile collected at sign-up (optional, self-declared, not verified).
  businessType              String?
  businessCity              String?
  /// Brands the account trades (buyer: buys, supplier: supplies). Self-declared.
  preferredBrands           String[] @default([])
  /// Onboarding reminders: set when an account starts with an incomplete business profile.
  profileIncompleteSince    DateTime?
  profileReminder1SentAt    DateTime?
  profileReminder2SentAt    DateTime?
  profileReminderFailures   Int      @default(0)
  /// Tokens without a session id issued before this time are rejected ("sign out everywhere").
  tokensValidAfter          DateTime?
  /// SHA-256 hashes of unused 2FA backup codes.
  twoFactorBackupCodes      String[] @default([])

  // Business & Financial Fields
  vatNumber   String? @unique
  taxId       String?
  country     String?
  bankAddress String? // Supplier specific
  iban        String?
  swiftCode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  offers       Offer[]
  customerOrders    Order[] @relation("CustomerOrders")
  supplierOrders    Order[] @relation("SupplierOrders")
  adminActions AdminActionLog[] @relation("AdminActions")
  notifications Notification[]
  sentMessages  SupportMessage[] @relation("SentMessages")
  reviews          Review[]
  wishlist         WishlistItem[]
  customerDisputes Dispute[] @relation("CustomerDisputes")
  customerInvoices Invoice[] @relation("CustomerInvoices")

  kycStatus     KYCStatus @default(UNVERIFIED)
  kycDocuments  KYCDocument[]

  onboardingCompleted Boolean @default(false)
  stripeOnboarded     Boolean @default(false)

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model KYCDocument {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  documentType  String    // e.g., "NATIONAL_ID", "PASSPORT"
  frontImageUrl String
  backImageUrl  String?
  selfieUrl     String?   // Camera captured snapshot
  livenessScore Float?    // Score indicating real human

  status        KYCStatus @default(PENDING)
  adminNotes    String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String
  price       Float
  basePrice   Float?
  stock       Int           @default(0)
  category    String
  images      String[]
  /// Where a photo came from when it isn't the supplier's own (licence and attribution to show with it). Shape:
  ///   { "<image url>": { "source": "Open Food Facts", "license": "CC BY-SA 3.0", "licenseUrl": "…", "attribution": "Open Food Facts contributors", "sourceUrl": "…", "barcode": "…", "addedAt": "ISO date",
  ///                      "origin"?: "discovery", "originalUrl"?: "…", "chosenBy"?: "supplier" | "staff", "approvedBy"?: userId, "approvedByRole"?: role, "approvedAt"?: ISO, "tier"?: 1 | 2 | 3 | null, "imgid"?: "…" } }
  /// Null / missing key = the supplier's (or staff's) own uploaded photo.
  imageCredits Json?
  /// Background photo search by barcode for a product saved without a photo (a person must approve any result;
  /// nothing here is ever applied automatically). Additive and optional; null = no search for this product. Shape:
  ///   { "status": "searching" | "found_review" | "not_found" | "unavailable" | "invalid_barcode", "mode"?: "fill" | "add",
  ///     "barcode": "…", "startedAt"?: ISO, "checkedAt"?: ISO, "reason"?: code, "reasons"?: [code],
  ///     "candidates": [{ "url", "previewUrl", "source", "sourceUrl", "license", "licenseUrl", "attribution",
  ///                      "confidence": "verified" | "needs_confirmation", "reasons": [code], "kind", "language", "width", "height", "imgid",
  ///                      "tier": 1 | 2 | 3 | null, "score": n, "breakdown": [{ "key", "points" }], "visual": {…}, "role": "primary" | "gallery" | "review" }],
  ///     "record"?: { productName, brand, quantity, sourceUrl }, "dismissed"?: [url], "attempts"?: n, "requestedBy"?: { id, role } }
  /// See backend/src/products/image-discovery.service.ts and image-quality.ts.
  /// Kept apart from `status` (ProductStatus is the review workflow; this is only a hint for the supplier).
  imageDiscovery Json?
  // Short product demo videos — same array shape as images. Each
  // entry is a public URL: an uploaded MP4/WebM/MOV under /uploads,
  // or an https direct-link the supplier pasted. NOT YouTube/Vimeo
  // embeds — operator rule: short demo clips only, max 60 seconds.
  // The PDP renders them inline with native <video> controls.
  videos      String[]      @default([])
  ean         String?
  brand       String?
  unit        String        @default("carton")
  variants    Json?
  // Per-variant pricing for mixed-tier orders. Shape:
  //   { "Flavour=Diet": 14.50, "Flavour=Regular": 13.20, ... }
  // The KEY is the variant signature (same convention used by
  // variantStock). The VALUE is the price-per-case the supplier
  // wants for that specific variant — used when the customer
  // mixes multiple variants inside one truck/pallet at checkout.
  // When missing, mix-composer falls back to Product.basePrice.
  variantPrices Json?
  // Per-variant display metadata for the mix composer. Shape:
  //   { "Flavour=Diet": { "image": "https://…", "label": "Pepsi Diet" }, ... }
  // Lets the supplier upload a distinct image + a cleaner label for
  // each variant — otherwise the composer falls back to the parent
  // product image + the raw signature.
  variantMeta Json?
  // Per-variant stock map for configurable products. Shape:
  //   { "Size=Large|Flavour=Vanilla": 12, "Size=Small": 0, ... }
  // The KEY is the variant signature (groups sorted alphabetically,
  // joined by "|", each group as "name=value"). Suppliers manage
  // each variant's count independently on /supplier/inventory.
  //
  // Product.stock stays as the global counter — it remains the
  // source of truth for non-configurable products. For variant
  // products the inventory page renders the variantStock map and
  // the supplier can rebalance freely; the existing order flow
  // still reads Product.stock (variant-aware decrement is a
  // follow-up — minor risk because variant orders are rare in the
  // pilot data).
  variantStock Json?
  status      ProductStatus @default(PENDING)
  adminNotes  String?
  moq         Int?          // Minimum Order Quantity (number of moqUnit)
  moqUnit     String?       @default("PIECE") // PIECE | CASE | PALLET | TRUCK — unit the MOQ is expressed in
  unitsPerCase       Int?   // Pieces per case/carton (e.g., 24 from "C24")
  casesPerPallet     Int?   // Cases per pallet
  unitsPerPallet     Int?   // Total pieces per pallet (derived: unitsPerCase × casesPerPallet)
  palletsPerShipment Int?
  shelfLife          String? // Expiry date or shelf-life string from supplier file
  weight             String? // Weight per unit (e.g., "250g", "1.5kg")
  origin             String? // Country of origin (e.g., "Germany", "China")
  exwLocation        String? // Where the product physically sits today (EXW Incoterm)
                              // — required by the supplier upload flow and shown on
                              // the PDP next to MOQ / Country of Origin so buyers
                              // can estimate transport cost from origin warehouse.
  previousPrice      Float?  // Last price before the most recent change (in EGP base) — used for price-change ticker
  priceChangedAt     DateTime? // Timestamp of the most recent price change
  /// Per-product override of the supplier's default fulfilment method (null = use the default).
  fulfillmentMethod String?
  readyForDispatch Boolean @default(true)
  leadTime       Int?     @default(0) // Preparation time in days if not ready for dispatch

  rating       Float @default(0.0)
  reviewsCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierId String
  supplier   User   @relation(fields: [supplierId], references: [id])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  placements   ProductPlacement[]
  offers       Offer[]
  orderItems   OrderItem[]
  tieredPrices TieredPrice[]
  reviews      Review[]
  wishlistItems WishlistItem[]
  changeLog    ProductChangeLog[]
  targetPrices TargetPriceRequest[]
  priceObservations PriceObservation[]
  promotions   Promotion[]
  reviewEvents ProductReviewEvent[]
  // What the supplier typed: price per case in their own currency. basePrice
  // (EUR) is derived from it; kept so the entered figure is never reinterpreted.
  supplierCurrency String?
  supplierPrice    Float?

  @@index([supplierId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model ProductPlacement {
  id            String          @id @default(uuid())
  placementType PlacementType
  status        PlacementStatus @default(PENDING)
  price         Float           @default(0)
  priorityOrder Int             @default(0)

  startDate DateTime?
  endDate   DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  history ProductPlacementHistory[]
  coupons Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductPlacementHistory {
  id          String           @id @default(uuid())
  placementId String
  placement   ProductPlacement @relation(fields: [placementId], references: [id])

  previousStatus PlacementStatus?
  newStatus      PlacementStatus
  changedById    String
  reason         String?

  createdAt DateTime @default(now())
}

model Order {
  id          String      @id @default(uuid())
  /// Client-generated per checkout attempt; a retried/double-clicked submit returns the same order.
  idempotencyKey String? @unique
  totalAmount Float
  status      OrderStatus @default(PENDING)

  // Stripe Payment
  paymentStatus    String  @default("UNPAID") // UNPAID | PROCESSING | PAID | FAILED | REFUNDED
  paymentIntentId  String?
  paidAt           DateTime?

  // Escrow — funds held until delivery confirmed, then released to supplier
  escrowStatus     String  @default("NOT_STARTED") // NOT_STARTED | HELD | RELEASED | REFUNDED
  escrowHeldAt     DateTime?  // when funds were locked
  escrowReleasedAt DateTime?  // when funds were sent to supplier

  shippingCompany String?
  shippingCost    Float?
  // The shipping company the buyer picked at checkout. Captured at
  // order-creation time and never overwritten by admin re-assignment —
  // so the admin order detail page can always show "this is what the
  // customer chose" even after operations re-routes the shipment.
  customerShippingCompany String?
  // Delivery address the buyer entered at checkout ({ name, company, street,
  // city, postal, country }) and its ISO country code, checked against the
  // delivery policy (shipping/delivery-policy.ts) when the order is created.
  shippingAddress    Json?
  destinationCountry String?
  // Supplier-uploaded invoice / receipt image (or PDF) for this order.
  // Customer sees it on /dashboard/customer/orders/[id]; admin sees it
  // on /admin/orders/[id]. Optional — populated when the supplier
  // attaches paperwork via the supplier orders page.
  supplierInvoiceUrl String?

  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  supplierId String?
  supplier   User?   @relation("SupplierOrders", fields: [supplierId], references: [id])

  items   OrderItem[]
  history OrderStatusHistory[]
  invoices Invoice[]
  shipment Shipment?
  disputes Dispute[]
  chatMessages SupportMessage[] @relation("OrderChat")

  deletedByCustomer Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escrow    EscrowTransaction?

  // ── Confirmation workflow (orders/order-workflow.ts) ──────────────
  /// LEGACY (placed before the workflow existed) | PENDING_REVIEW | APPROVED | REJECTED
  reviewStatus   String    @default("LEGACY")
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNote     String?
  /// Version of the commercial terms; increases on every material change.
  termsVersion   Int       @default(1)
  /// The terms as the buyer submitted them (lines, prices, fulfillment, destination).
  submittedTerms Json?
  /// The terms Atlantis approved — frozen; what payment and fulfilment follow.
  termsSnapshot  Json?
  /// Set when the buyer accepted terms that differ from what they submitted.
  buyerAcceptedVersion Int?
  buyerAcceptedAt      DateTime?
  /// How each supplier's goods move, priced at checkout (fulfillment/fulfillment-calc.ts).
  fulfillment    Json?
  confirmations  OrderSupplierConfirmation[]
  inspections    OrderInspection[]

  @@index([customerId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([reviewStatus])
}

/// One supplier's explicit decision on one version of an order's terms.
model OrderSupplierConfirmation {
  id           String    @id @default(uuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId   String
  termsVersion Int
  /// PENDING | ACCEPTED | REJECTED | EXPIRED | SUPERSEDED
  status       String    @default("PENDING")
  requestedAt  DateTime  @default(now())
  deadline     DateTime?
  decidedAt    DateTime?
  decidedById  String?
  note         String?

  @@unique([orderId, supplierId, termsVersion])
  @@index([supplierId, status])
}

/// An inspection Atlantis staff performed on an order's goods (recorded, not simulated).
model OrderInspection {
  id             String    @id @default(uuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  hubId          String?
  /// SCHEDULED | PASSED | PASSED_WITH_FINDINGS | FAILED
  status         String    @default("SCHEDULED")
  inspectedAt    DateTime?
  inspectorName  String?
  /// [{ itemId, ordered, received, unit }]
  lines          Json?
  /// [{ type: BARCODE|QUANTITY|DATE|CONDITION|OTHER, itemId?, note }]
  findings       Json?
  photos         String[]  @default([])
  /// PENDING | ACCEPTED | ACCEPTED_WITH_DISCOUNT | PARTIALLY_ACCEPTED | REJECTED
  resolution     String?
  resolutionNote String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderId])
}

/// An Atlantis-operated or contracted hub. Shown publicly only when verified and active.
model AtlantisHub {
  id           String    @id @default(uuid())
  name         String
  city         String
  /// ISO 3166-1 alpha-2
  country      String
  address      String?
  latitude     Float
  longitude    Float
  /// INSPECTION | CONSOLIDATION | STORAGE | CROSS_DOCK | COLLECTION
  services     String[]  @default([])
  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  notes        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// A freight rate Atlantis configured. No rate → the route is "quote required", never estimated.
model FreightRate {
  id                 String   @id @default(uuid())
  /// ATLANTIS_COLLECTION (supplier warehouse → buyer) | HUB_TO_BUYER (Atlantis hub → buyer)
  method             String
  /// ISO2 of the dispatch point (supplier EXW country, or the hub's country)
  originCountry      String
  destinationCountry String
  hubId              String?
  /// CASE | PALLET | TRUCK
  unit               String
  amountEur          Float
  minTransitDays     Int?
  maxTransitDays     Int?
  active             Boolean  @default(true)
  note               String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([method, originCountry, destinationCountry])
}

/// A supplier's fulfilment defaults. Their net price never changes with the method.
model SupplierFulfillment {
  supplierId          String   @id
  /// ATLANTIS_COLLECTION | SUPPLIER_TO_HUB | SUPPLIER_DIRECT
  defaultMethod       String   @default("ATLANTIS_COLLECTION")
  /// What the supplier charges (EUR) to bring one pallet to the chosen hub — passed through, never marked up.
  hubFreightPerPallet Float?
  hubId               String?
  updatedAt           DateTime @updatedAt
}

model OrderStatusHistory {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  previousStatus OrderStatus?
  newStatus      OrderStatus
  changedById    String
  reason         String?

  createdAt DateTime @default(now())
}

model OrderItem {
  id       String @id @default(uuid())
  quantity Int
  price    Float
  // Cases taken from Product.stock when the order was placed (quantity ×
  // cases in the ordered tier). Restored on cancellation before dispatch.
  // Null on orders placed before this was recorded.
  stockCases Int?
  // The supplier's price for one ordered unit (case / pallet / truck) at
  // order time, before the Atlantis margin. Never sent to buyers.
  supplierUnitPrice Float?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // productId nullable so admins can delete a Product after orders exist —
  // the OrderItem keeps its quantity + price snapshot for order history,
  // but the live link to the Product row goes to NULL when the product is
  // removed. Frontend renders "Deleted product" when product is null.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshot of the product name at order time, in case the product is later
  // deleted. Optional — populated on order creation.
  productNameSnapshot String?
  // Shopify-style variant picks the buyer made on the PDP (size /
  // flavour / pack count / colour). Stored as a flat {group: value}
  // map so the admin order page can render the exact configuration
  // the buyer ordered:
  //   { "Size": "Large", "Flavour": "Vanilla", "Pack": "12-pack" }
  // The product itself keeps the available options in its own
  // `variants` Json column; this field is the snapshot of WHICH ones
  // were chosen for this order line. Optional — non-configurable
  // products leave it null.
  selectedVariants Json?
  // Selected tier (truck / pallet / case) at order time. Persisted
  // alongside the variants so the admin order page can show the
  // exact basket configuration without inferring it from price math.
  selectedTier String?
  // Mixed-tier composition. When the buyer used the "mix this truck"
  // composer, this holds the per-variant breakdown:
  //   [ { signature: "Flavour=Diet",    quantity: 5,  unitPrice: 14.50 },
  //     { signature: "Flavour=Regular", quantity: 10, unitPrice: 13.20 },
  //     ... ]
  // The row's own `quantity` is the SUM of these quantities (= the
  // tier capacity), and `price` is the marked-up total line price.
  // Null for single-variant order lines.
  mixComposition Json?
  /// Set when this line is a server-validated mixed pallet/truckload (see MixedLoad).
  mixedLoadId String?
  /// The special offer (Promotion) honoured on this line at order time, and its percentage.
  /// `price` and `supplierUnitPrice` already include it; these only record why. Null = none.
  promotionId      String?
  promotionPercent Float?
}

model AdminActionLog {
  id         String @id @default(uuid())
  action     String // e.g., "APPROVE_PLACEMENT", "REJECT_SUPPLIER"
  entityType String // e.g., "ProductPlacement", "Supplier"
  entityId   String
  details    Json?

  adminId String
  admin   User   @relation("AdminActions", fields: [adminId], references: [id])

  createdAt DateTime @default(now())
}

model SecurityLog {
  id          String   @id @default(uuid())
  level       String // INFO, WARN, CRITICAL
  eventType   String // BRUTE_FORCE, XSS_ATTEMPT, SQLI_ATTEMPT, UNAUTHORIZED_ACCESS, etc.
  description String
  ip          String?
  userId      String?
  path        String?
  method      String?
  payload     Json?
  headers     Json?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model BlockedIp {
  id          String    @id @default(uuid())
  ip          String    @unique
  reason      String
  expiresAt   DateTime?
  isPermanent Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SecurityConfig {
  id          String   @id @default(uuid())
  key         String   @unique // e.g., "EMERGENCY_LOCKDOWN", "BRUTE_FORCE_THRESHOLD"
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

/// Promo codes buyers enter at checkout. Rules (backend/src/coupons/coupon-rules.ts) are applied only on the
/// server, in OrdersService.priceCart (quote and order creation); the discount comes off the goods subtotal
/// after line discounts and is funded by the Atlantis margin (supplier net prices never change).
model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  /// PERCENT coupons: 1–100. FIXED coupons store 0 here and the EUR amount in amountOff.
  discountPercent Float
  /// End of the validity window (UTC). Kept under its original name; coupons are refused after it.
  expirationDate  DateTime

  /// Legacy: coupons created "for an offer" before scopes existed. Optional since 2026-10 (new coupons use scope);
  /// a legacy coupon applies to that placement's product only.
  placementId String?
  placement   ProductPlacement? @relation(fields: [placementId], references: [id], onDelete: Restrict)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// PERCENT | FIXED. Null = PERCENT (coupons created before 2026-10).
  discountType     String?
  /// FIXED coupons: EUR off the eligible goods, capped at the eligible amount.
  amountOff        Float?
  /// Start of the validity window (UTC). Null = valid from creation.
  startsAt         DateTime?
  /// Minimum goods subtotal (EUR, after line discounts, before the coupon). Null = none.
  minOrderAmount   Float?
  /// Total orders that may use the code. Null = unlimited. Enforced atomically against usedCount at order creation.
  usageLimit       Int?
  /// Orders one buyer account may place with the code. Null = unlimited.
  perCustomerLimit Int?
  /// Orders created with the code since redemption tracking began (one per CouponRedemption).
  usedCount        Int      @default(0)
  /// ALL | CATEGORY | PRODUCTS. Null = legacy (placement product).
  scope            String?
  /// CATEGORY scope: Product.category values (any of them).
  categories       String[] @default([])
  /// Internal note / campaign name (admins only, never shown to buyers).
  description      String?
  /// PRODUCTS scope: Product ids.
  productIds       String[] @default([])
  createdById      String?

  redemptions CouponRedemption[]
}

/// One row per order created with a coupon (a "redemption"). Written in the order's transaction; never released
/// when the order is later rejected or cancelled (the use counted when the order request was placed).
model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  orderId    String   @unique
  customerId String
  /// EUR taken off the order's goods total.
  discount   Float
  createdAt  DateTime @default(now())

  @@index([couponId, customerId])
}

model AppConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR, NEW_REGISTRATION, NEW_REVIEW, SYSTEM_ALERT
  data      Json?    // Store exact errors array or other structured data
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model TieredPrice {
  id              String  @id @default(uuid())
  minQty          Int
  maxQty          Int?    // null = unlimited (e.g., 100+)
  discountPercent Float   // e.g., 5.0 means 5% off

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, minQty])
}

model CustomerPriceGroup {
  id              String  @id @default(uuid())
  name            String  @unique
  discountPercent Float   // group-wide extra discount %
  description     String?

  members  CustomerGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerGroupMember {
  id      String @id @default(uuid())
  userId  String
  groupId String

  group CustomerPriceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, groupId])
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User     @relation("CustomerInvoices", fields: [customerId], references: [id])
  amount        Float
  tax           Float    @default(0)
  totalAmount   Float
  currency      String   @default("USD")
  status        String   @default("ISSUED") // ISSUED, PAID, OVERDUE, CANCELLED
  dueDate       DateTime?
  paidAt        DateTime?
  pdfUrl        String?  // path to generated PDF
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CreditTerm {
  id              String   @id @default(uuid())
  userId          String   @unique
  creditLimit     Float    @default(0)     // max outstanding balance
  usedCredit      Float    @default(0)     // current outstanding
  paymentTermDays Int      @default(30)    // Net 30, Net 60, etc.
  status          String   @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED
  approvedBy      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TaxExemption {
  id              String   @id @default(uuid())
  userId          String
  certificateUrl  String   // uploaded file path
  certificateType String   @default("VAT_EXEMPT") // VAT_EXEMPT, TAX_FREE_ZONE, etc.
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  validFrom       DateTime?
  validUntil      DateTime?
  reviewedBy      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String
  country   String
  zipCode   String?
  latitude  Float?
  longitude Float?
  supplierId String
  isDefault Boolean  @default(false)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportMessage {
  id           String   @id @default(uuid())
  senderId     String
  sender       User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId   String?  // if null, it's addressed to general support
  content      String?
  imageUrl     String?
  isRead       Boolean  @default(false)
  isBot        Boolean  @default(false)
  assignedTeam String?  // e.g., 'DEVELOPER', 'LOGISTICS'
  isHandedOver Boolean  @default(false) // true = human took over from bot
  handedOverBy String?  // userId of the support agent who took over

  // Order-linked chat — set when this message belongs to a specific order conversation
  orderId      String?
  orderContext Order?   @relation("OrderChat", fields: [orderId], references: [id], onDelete: SetNull)
  // Order threads are one per participant: the buyer, or one supplier on the
  // order. null = the order's buyer (messages written before suppliers had threads).
  partyId      String?

  createdAt    DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([orderId])
  @@index([orderId, partyId])
  @@index([createdAt])
}

model Shipment {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber  String   @unique
  carrier         String?
  status          String   @default("PENDING")
  expectedDelivery DateTime?
  
  updates         ShipmentUpdate[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ShipmentUpdate {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  status      String
  description String
  location    String?
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      // 1-5
  comment   String?
  images    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])  // One review per user per product
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUND
  RESOLVED_NO_REFUND
  CLOSED
}

model Dispute {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User          @relation("CustomerDisputes", fields: [customerId], references: [id])
  reason      String        // e.g. "Item not received", "Wrong item", "Damaged"
  description String
  evidence    String[]      // uploaded image URLs
  status      DisputeStatus @default(OPEN)
  resolution  String?       // admin resolution note
  resolvedBy  String?       // admin userId
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model WishlistItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─── Webhook Idempotency ─────────────────────────────────────────────────────
// Stores every Stripe event ID that has been processed.
// Before handling a webhook, we check this table — if already present we skip.
// Prevents double-charging or double-payouts on webhook retries / replay attacks.
model ProcessedWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique   // Stripe event ID (e.g. evt_xxx)
  eventType   String             // e.g. payment_intent.succeeded
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ─── Financial Audit Log ─────────────────────────────────────────────────────
// Immutable record of every financial operation on the platform.
// Append-only: NEVER update or delete rows — only INSERT.
// Covers: payment created, payment succeeded, escrow held/released/refunded,
//         supplier payout sent, invoice generated, refund issued.
model FinancialAuditLog {
  id          String   @id @default(uuid())
  eventType   String   // PAYMENT_CREATED | PAYMENT_SUCCEEDED | PAYMENT_FAILED |
                       // ESCROW_HELD | ESCROW_RELEASED | ESCROW_REFUNDED |
                       // PAYOUT_SENT | REFUND_ISSUED | INVOICE_GENERATED
  orderId     String?
  userId      String?  // buyer or supplier depending on event
  amount      Float?   // in USD
  currency    String   @default("USD")
  stripeId    String?  // PaymentIntent ID / Transfer ID / Refund ID
  status      String   @default("OK")  // OK | FAILED
  metadata    Json?    // any extra context
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

// ─── Refresh Token Store ─────────────────────────────────────────────────────
// Stores hashed refresh tokens for rotation — each token is single-use.
// On use, old token is deleted and a new one is issued.
// Prevents refresh token replay attacks.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique   // SHA-256 hash of the raw token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// The sign-in session this (rotating) token belongs to.
  sessionId String?

  @@index([userId])
  @@index([expiresAt])
}

// ─── Login Attempt Log ───────────────────────────────────────────────────────
// Tracks failed login attempts per email for account lockout logic.
// Auto-cleaned after 24 hours by a cron job.
model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, success, createdAt])
  @@index([createdAt])
}

// ===== ESCROW SYSTEM =====

enum EscrowStatus {
  HOLDING      // Payment authorized, not captured
  CAPTURED     // Payment confirmed, funds held
  RELEASED     // Paid out to supplier
  REFUNDED     // Returned to customer
  DISPUTED     // Under review
}

model EscrowTransaction {
  id               String       @id @default(cuid())
  orderId          String       @unique
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Float
  currency         String       @default("USD")
  platformFee      Float
  supplierAmount   Float
  status           EscrowStatus @default(HOLDING)
  stripeIntentId   String?
  stripeTransferId String?
  capturedAt       DateTime?
  releasedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

/**
 * Supplier offer on an existing platform product.
 *
 * Workflow:
 *   1. Supplier creates an Offer (manual form OR bulk-upload sheet).
 *      The offer references an existing Product (matched by name on
 *      bulk import). One row = one offer = one (supplier, product)
 *      pair at a chosen tier and price.
 *   2. Status starts as PENDING.
 *   3. Admin reviews on /admin/offers — approves or rejects.
 *   4. On APPROVE, the backend blasts a campaign email to every
 *      ACTIVE newsletter subscriber + every CUSTOMER on the
 *      platform with the offer details (product, price, qty,
 *      tier, supplier). On REJECT, the supplier is notified.
 */
model Offer {
  id           String   @id @default(uuid())
  supplierId   String
  supplier     User     @relation(fields: [supplierId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  pricePerUnit Float    // price in EUR for ONE unit at the chosen tier
  unit         String   // 'truck' | 'pallet' | 'carton'
  quantity     Int      // how many units the supplier can deliver
  validUntil   DateTime?
  notes        String?

  // ── Offer-specific batch details (operator requirement) ───────────────
  // These are required at form-submit time. Pre-filled from the linked
  // Product where applicable, but the supplier can override per offer
  // (different batch BBD, different EXW location, batch-specific photo,
  // etc). All optional in the DB so old rows don't break — required at
  // the controller layer when status would flip to PENDING.
  productNameSnap   String?   // "KitKat Chunky 40g" — full name as on the offer
  bbd               String?   // batch best-before date / shelf-life (free text)
  eanCode           String?
  unitsPerCase      Int?
  casesPerPallet    Int?
  exwLocation       String?   // where this batch sits today
  leadTime          String?   // how soon supplier can ship (e.g. "5 working days")
  origin            String?   // country of origin for this batch
  offerImageUrl     String?   // batch-specific photo of the product

  // Discount applied to this offer (operator-requested promo flow).
  //   discountPercent: a single percentage applied to every unit
  //     in the offer (e.g. 15 → 15 % off pricePerUnit).
  //   variantDiscounts: per-variant overrides keyed by variant
  //     signature, e.g. { "Flavour=Diet": 20, "Flavour=Regular": 10 }.
  //     When set, the supplier wanted DIFFERENT discounts per variant;
  //     otherwise discountPercent applies to all variants uniformly.
  // Both are optional — a 0/missing value means "no discount".
  discountPercent  Float?
  variantDiscounts Json?

  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  adminNotes   String?
  approvedAt   DateTime?
  approvedBy   String?  // admin user id

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supplierId])
  @@index([productId])
  @@index([status])
}

/**
 * A sent (or saved) marketing campaign. The Newsletter Hub's campaign
 * builder writes one of these every time admin clicks "Send" — the
 * full HTML of the email is stored verbatim so the admin can re-open
 * a past campaign in the builder and re-send it without rebuilding.
 */
model Campaign {
  id            String   @id @default(uuid())
  subject       String
  html          String   @db.Text     // fully-rendered Atlantis email
  audience      String   // 'PLATFORM' | 'NEWSLETTER'
  sentCount     Int      @default(0)
  totalCount    Int      @default(0)
  status        String   @default("SENT") // SENT | DRAFT | FAILED
  sentBy        String?  // admin user id
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Campaign builder (additive, 2026-10). Status for new rows is set explicitly:
  // DRAFT → SENDING → SENT (every attempted recipient accepted by the provider) |
  // PARTIAL (some accepted, some failed) | FAILED (none accepted). "Sent" means
  // accepted by the provider, never "delivered" (no provider delivery reports).
  preheader     String?
  template      String?  // BLANK | ANNOUNCEMENT | PRODUCTS
  content       Json?    // structured builder state (headline, paragraphs, CTA, productIds)
  audienceSpec  Json?    // { audience: NEWSLETTER | ACCOUNTS | ALL, roles?, region?, source? }
  failedCount   Int      @default(0)
  skippedCount  Int      @default(0)
  lastError     String?
  createdBy     String?
  sendStartedAt DateTime?
  sentAt        DateTime? // when the send run finished
  lastTestAt    DateTime?
  lastTestResult String?
  recipients    CampaignRecipient[]

  @@index([createdAt])
  @@index([status])
}

/**
 * One row per (campaign, normalised email): makes sending idempotent (a
 * recipient is attempted at most once per campaign, even if a send is resumed)
 * and records the provider's answer. ACCEPTED = the provider accepted the
 * message; nothing here claims delivery.
 */
model CampaignRecipient {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email       String    // normalised (trimmed, lowercased)
  status      String    @default("PENDING") // PENDING | ACCEPTED | FAILED | SKIPPED
  skipReason  String?   // consent / suppression reason when the pre-send check said no
  error       String?
  provider    String?
  providerId  String?
  attemptedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

/**
 * Marketing suppression by normalised email, kept apart from the contact row so
 * deleting, re-importing or re-adding a contact can never undo an unsubscribe.
 * Lifted only by the person's own explicit opt-in (confirmed newsletter
 * sign-up, or switching marketing emails back on in their own account).
 */
model MarketingSuppression {
  id                 String    @id @default(uuid())
  email              String    @unique
  reason             String    // UNSUBSCRIBED | BOUNCED | COMPLAINED | BLOCKED
  source             String?   // LINK | ONE_CLICK | EMAIL_FORM | ADMIN | PROVIDER
  suppressedAt       DateTime  @default(now())
  // True when the unsubscribe also switched the matching account's
  // marketingEmails preference off, so a later "on" can only be the user's own choice.
  accountPrefCleared Boolean   @default(false)
  liftedAt           DateTime?
  liftedReason       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([reason])
}

/** Append-only consent history per normalised email (subscribe, confirm, unsubscribe, admin actions). */
model MarketingConsentEvent {
  id         String   @id @default(uuid())
  email      String
  type       String   // SUBSCRIBE_REQUESTED | CONFIRMED | UNSUBSCRIBED | RESUBSCRIBED | ADMIN_ADDED | IMPORTED | CONSENT_RECORDED | BLOCKED | UNBLOCKED | ARCHIVED | RESTORED | DELETED
  source     String?
  actorId    String?
  campaignId String?
  offerId    String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

/** Random per-recipient unsubscribe token (only its SHA-256 is stored). */
model MarketingUnsubscribeToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  email      String
  campaignId String?
  offerId    String?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

/**
 * Append-only email-tracking log. One row per email-related event:
 *   SENT    — written when the platform fires an email (campaign,
 *             offer blast, system transactional). Captures the
 *             recipient + subject + a unique tracking id used by
 *             the open / click pixels.
 *   OPEN    — written when the recipient's mail client loads the
 *             tracking pixel. Multiple per recipient is fine.
 *   CLICK   — written when the recipient clicks a wrapped link.
 *             linkUrl carries the destination they were heading to.
 *
 * The admin email-analytics page reads these rows back to compute
 * sent / opened / clicked / open-rate / click-rate per campaign or
 * per offer.
 */
model EmailEvent {
  id          String   @id @default(uuid())
  trackingId  String   @unique     // shared between SENT and the OPEN/CLICK rows that follow
  type        String              // SENT | OPEN | CLICK | BOUNCE
  recipient   String              // lowercased email
  subject     String?
  campaignId  String?             // when this email belongs to a /newsletter campaign
  offerId     String?             // when this email is an approved-offer blast
  linkUrl     String?             // populated for CLICK events
  userAgent   String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([trackingId])
  @@index([campaignId])
  @@index([offerId])
  @@index([recipient])
  @@index([type])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  /**
   * Optional display name uploaded with the email — useful for the
   * admin Newsletter UI to show "Acme Wholesale (purchasing@acme.com)"
   * instead of just the address. Imports via the bulk-upload endpoint
   * fill this from the sheet's Name column.
   */
  name      String?
  /**
   * ACTIVE       — receives campaigns
   * UNSUBSCRIBED — opted out, never gets emails again
   * BOUNCED      — bad address, suppressed by mailer
   * BLOCKED      — admin-blocked, kept on file but cannot receive
   * HIDDEN       — admin-hidden from default lists (soft-archive)
   */
  status    String   @default("ACTIVE")
  source    String?  // e.g., "Homepage Footer", "Bulk Upload", "Direct RFQ"
  region    String?  // e.g., "Europe", "MENA"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Consent record (marketing newsletter only — separate from account /
  // order notifications). PENDING = signed up, waiting for the email
  // confirmation (double opt-in). Rows created before these fields
  // existed have null consent data (legacy).
  consentAt        DateTime?
  consentSource    String?   // where consent was given, e.g. "footer"
  policyVersion    String?   // privacy notice version shown at consent
  confirmTokenHash String?   @unique
  confirmSentAt    DateTime?
  confirmedAt      DateTime?
  unsubscribeToken String?   @unique
  unsubscribedAt   DateTime?
  userId           String?   // linked account, when signed in at sign-up

  // ── Contact management (additive, 2026-10) ──
  company             String?
  // How marketing consent was obtained: FORM_DOUBLE_OPT_IN (confirmed sign-up),
  // ADMIN_RECORDED (an admin entered the basis in consentEvidence), NONE (no
  // basis: imported / manual contacts are not sendable). Null on older rows.
  consentBasis        String?
  consentEvidence     String?
  consentRecordedById String?
  consentRecordedAt   DateTime?  // when the admin recorded the basis (not when consent was given)
  addedById           String?
  lastImportedAt      DateTime?

  @@index([email])
  @@index([status])
}

// A buyer's desired price for a product. Routed to Atlantis operations, who
// negotiate with the supplier. Never changes the listing or creates an order.
model TargetPriceRequest {
  id              String    @id @default(uuid())
  ref             String    @unique          // short human reference, e.g. TP-7K3Q9A
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User      @relation("TargetPriceBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  // Normalised target: buyer price per CASE in EUR (same basis as listings).
  targetCasePrice Float
  // Exactly what the buyer typed.
  enteredPrice    Float
  enteredBasis    String                     // CASE | PIECE
  currency        String    @default("EUR")
  quantity        Int
  quantityUnit    String                     // CASE | PALLET | TRUCK
  quantityCases   Int
  message         String?
  // Where the buyer wants the goods (ISO 3166-1 alpha-2), optional. Additive; null on older requests.
  deliveryCountry String?
  // OPEN → RESPONDED (counter / info) → ACCEPTED | DECLINED; or WITHDRAWN by the buyer.
  status          String    @default("OPEN")
  response        String?
  counterCasePrice Float?
  respondedAt     DateTime?
  respondedById   String?
  reachedNotifiedAt DateTime?               // buyer told the listed price reached the target
  // Negotiation (additive, 2026-10-21; null on older requests). Stored statuses are unchanged:
  // ACCEPTED = agreed (the desk accepted the target as asked, or the buyer accepted the desk's counter);
  // DECLINED = closed by the desk or by the buyer declining a counter (buyerDecision tells which).
  listedCasePriceAtRequest Float?           // listed BUYER price per case (EUR) when the request was sent
  originalTargetCasePrice  Float?           // first target, kept when the buyer sends a revised target
  counterQuantityCases     Int?             // cases the desk's counter applies to (null = the requested quantity)
  buyerDecision            String?          // ACCEPTED | DECLINED | REVISED — the buyer's answer to the current desk reply
  buyerDecidedAt           DateTime?
  agreedCasePrice          Float?           // agreed buyer price per case (EUR), set only when status becomes ACCEPTED
  agreedQuantityCases      Int?
  agreedAt                 DateTime?
  history         Json      @default("[]")   // [{status, at, by, note, action?, price?, cases?}]
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([productId, status])
  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

// Buyer-facing listed price over time, one row each time it changes.
// Basis: price per case at the case tier, EUR. Never the supplier price.
model PriceObservation {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  casePrice  Float
  currency   String   @default("EUR")
  basis      String   @default("LISTED_CASE")
  source     String                          // PRICE_CHANGE | APPROVED | OBSERVED
  observedAt DateTime @default(now())

  @@index([productId, observedAt])
}

model InviteToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String?
  role      String   @default("CUSTOMER")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdBy String?  // admin user id
  createdAt DateTime @default(now())
  /// Team invitations (kind = "STAFF", backend/src/admin/team.service.ts): `token` holds the
  /// SHA-256 of the link secret, never the secret itself. The rest are null on older rows.
  kind           String?
  name           String?
  /// SENDING | SENT | FAILED. Only a SENT invitation can be accepted.
  emailStatus    String?
  emailError     String?
  sentAt         DateTime?
  usedAt         DateTime?
  revokedAt      DateTime?
  revokedBy      String?
  acceptedUserId String?
  updatedAt      DateTime? @updatedAt

  @@index([token])
  @@index([email])
}

/// A buyer's mixed pallet or truckload, built from several products of ONE
/// supplier. Lines are validated and priced on the server (src/orders/pricing.ts);
/// a DRAFT becomes ORDERED inside the order-creation transaction.
model MixedLoad {
  id         String   @id @default(uuid())
  customerId String
  /// PALLET (filled with cases) | TRUCK (filled with pallets)
  kind       String
  /// DRAFT | ORDERED
  status     String   @default("DRAFT")
  supplierId String?
  /// [{ productId, variant?, quantity }]
  lines      Json     @default("[]")
  /// Optimistic-concurrency counter — every update must send the version it read.
  version    Int      @default(0)
  orderId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, status])
}



/// A buyer's saved shopping list ("Weekly drinks", "Store #2 restock").
/// Prices are never stored: reordering always re-prices from the live catalog.
model ShoppingList {
  id        String             @id @default(uuid())
  userId    String
  name      String
  description String?
  /// Reorder reminder: notify (never auto-order) at nextReminderAt; repeat = none | weekly | monthly.
  reminderRepeat  String    @default("none")
  nextReminderAt  DateTime?
  lastRemindedAt  DateTime?
  items     ShoppingListItem[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
}

model ShoppingListItem {
  id               String       @id @default(uuid())
  listId           String
  list             ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Plain id (no FK) so deleting a product never deletes a buyer's list; shown as unavailable instead.
  productId        String
  /// "" for products without variants; otherwise "Group=Value|Group=Value" (sorted).
  variantKey       String       @default("")
  selectedVariants Json?
  /// carton | pallet | truck
  tier             String       @default("carton")
  quantity         Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([listId, productId, variantKey, tier])
}

/// One sign-in on one device. Access tokens carry its id (sid); revoking it
/// signs that device out on its next request.
model UserSession {
  id         String    @id @default(uuid())
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}


// Audit trail for supplier-relevant product changes (price, stock, status,
// identity fields). One row per changed field.
model ProductChangeLog {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorId   String?
  field     String
  oldValue  String?
  newValue  String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

/// A scheduled special offer on one product: a temporary percentage off the supplier's net price
/// (basePrice). The buyer price follows through the normal markup, so both drop by the same
/// percentage and the Atlantis markup ratio is unchanged (see backend/src/promotions/promotion-rules.ts).
/// Lifecycle is derived from time on every request: Scheduled (now < startsAt), Active
/// (startsAt <= now < endsAt, product approved), Expired (now >= endsAt). Only a cancellation is stored.
/// Not the same thing as Offer (a supplier batch / wholesale offer that Atlantis reviews).
model Promotion {
  id                  String    @id @default(uuid())
  productId           String
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The product's supplier when the promotion was created (ownership is always re-checked on the product).
  supplierId          String
  /// Optional internal campaign name (shown to the supplier and Atlantis, never to buyers).
  name                String?
  discountPercent     Float
  /// UTC instants. Active from startsAt (inclusive) until endsAt (exclusive).
  startsAt            DateTime
  endsAt              DateTime
  /// ACTIVE | CANCELLED. "ACTIVE" only means "not cancelled"; the state shown is derived from time.
  status              String    @default("ACTIVE")
  /// Supplier net price per case when the promotion was created (reference only: the discount
  /// always applies to the price at quote time).
  basePriceAtCreation Float?
  createdById         String
  createdByRole       String?
  updatedById         String?
  cancelledById       String?
  cancelledAt         DateTime?
  cancelReason        String?
  /// Audit trail: [{ at, by, role, action: "CREATE" | "UPDATE" | "CANCEL", changes?: { field: [old, new] }, reason? }]
  history             Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([productId, startsAt, endsAt])
  @@index([supplierId])
  @@index([endsAt])
}

/// Review trail of a product listing: every submission, Atlantis decision and feedback message, in order.
/// Additive — Product.adminNotes keeps holding the latest message for older screens; this table keeps the history
/// with its author and time so a supplier can read what was asked and Atlantis can see what happened before.
model ProductReviewEvent {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// SUBMITTED | RESUBMITTED | CHANGES_REQUESTED | APPROVED | REJECTED | STATUS_CHANGED
  action      String
  message     String?
  /// Product status right after this event.
  statusAfter String?
  actorId     String?
  actor       User?    @relation("ProductReviewActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Role of the actor at the time (SUPPLIER, ADMIN, OWNER, MODERATOR, SYSTEM).
  actorRole   String?
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([action, createdAt])
}
